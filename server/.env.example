DATABASE_URL=

REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Optional. When unset, each worker auto-assigns the next
# sequential ID (worker-1, worker-2, ...) so multiple
# `npm run start:worker` terminals register as distinct workers.
# WORKER_ID=worker-1
WORKER_CONCURRENCY=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_QUEUE_SIZE=100

PORT=5000