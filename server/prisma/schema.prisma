generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id       Int     @id @default(autoincrement())
  jobId    String  @unique
  name     String
  status   String
  progress Int     @default(0)
  payload  Json?
  result   Json?
  error    String?

  attempts Int @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}
