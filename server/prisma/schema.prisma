generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          Int     @id @default(autoincrement())
  jobId       String  @unique
  name        String
  bullmqJobId String?
  status      String
  priority    Int     @default(1)
  progress    Int     @default(0)
  payload     Json?
  result      Json?
  error       String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  isDeadLetter Boolean @default(false)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  scheduledAt DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  attempts_history JobAttempt[]

  dependencies JobDependency[] @relation("JobDependencies")

  dependents JobDependency[] @relation("JobDependents")

  @@map("jobs")
}

model JobAttempt {
  id Int @id @default(autoincrement())

  jobId Int

  attemptNumber Int
  bullmqJobId   String

  workerId String

  status String

  startedAt   DateTime
  completedAt DateTime?
  duration    Int?

  error String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([bullmqJobId])
}

model JobDependency {
  id Int @id @default(autoincrement())

  jobId          Int
  dependsOnJobId Int

  job Job @relation("JobDependencies", fields: [jobId], references: [id], onDelete: Cascade)

  dependsOn Job @relation("JobDependents", fields: [dependsOnJobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobId, dependsOnJobId])
}
